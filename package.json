{
  "name": "bitrix24-deal-checker",
  "version": "1.0.0",
  "description": "Проверка сделок Битрикс24 через Playwright",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "check": "node start.js",
    "update:check": "node scripts/update-cli.js check",
    "update:apply": "node scripts/update-cli.js apply",
    "build:gui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-gui.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-all.ps1",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bitrix24",
    "playwright",
    "crm"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.65.0",
    "xlsx": "^0.18.5"
  }
}
